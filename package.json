{
  "name": "apex-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Apex Hub community chat app",
  "scripts": {
    "start:server": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "build:web": "node scripts/build-web.cjs",
    "build:desktop": "npm run build:web && electron-builder --win nsis",
    "build:android": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.apexhub.app",
    "productName": "Apex Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Apex-Hub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false
  }
}
