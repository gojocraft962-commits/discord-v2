{
  "name": "apex-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Apex Hub community chat app",
  "scripts": {
    "start:server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "build:web": "node scripts/build-web.cjs",
    "build:desktop": "npm run build:web && electron-builder --win nsis",
    "build:android": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.apexhub.app",
    "productName": "Apex Hub",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}